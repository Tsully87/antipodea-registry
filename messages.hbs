{{#if threads.length}}
<ul class="ap-threads">
  {{#each threads}}
  <li>
    <button type="button" data-action="apOpenThread" data-other="{{other}}">
      {{#if rotom}}<span class="ap-rotom-face avatar"><i></i><i></i></span>{{else}}<img class="ap-avatar" src="{{img}}" alt="">{{/if}}
      <span class="ap-thread-text"><strong>{{name}}</strong><small>{{#if mine}}You: {{/if}}{{preview}}</small></span>
      <span class="ap-thread-meta"><small>{{time}}</small>{{#if unread}}<span class="ap-count inline">{{unread}}</span>{{/if}}</span>
    </button>
  </li>
  {{/each}}
</ul>
{{else}}
<div class="ap-emptystate">
  <i class="fa-solid fa-comment-slash"></i>
  <p>No messages yet.</p>
  <button type="button" class="ap-pill" data-action="apGo" data-app="contacts">Start a conversation</button>
</div>
{{/if}}
