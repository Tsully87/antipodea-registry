{{#if photo404}}
<p class="ap-hint-center">That photo's gone.</p>
{{else}}
<img class="ap-photo-full" src="{{shot.src}}" alt="" data-action="apPhotoFull" data-src="{{shot.src}}">
<p class="ap-hint-center">{{shot.label}}</p>
<div class="ap-photo-actions">
  {{#if canPost}}<button type="button" class="ap-share" data-action="apPhotoPost"><i class="fa-solid fa-camera-retro"></i> Post to PokéGram</button>{{/if}}
  <div class="ap-row">
    <select data-photo-send>
      <option value="">Send to...</option>
      {{#each sendTo}}<option value="{{id}}">{{name}}</option>{{/each}}
    </select>
    <button type="button" class="ap-pill" data-action="apPhotoSend" disabled><i class="fa-solid fa-paper-plane"></i></button>
  </div>
  <button type="button" class="ap-link danger" data-action="apPhotoDelete"><i class="fa-solid fa-trash"></i> Delete photo</button>
</div>
{{/if}}
