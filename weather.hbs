<div class="ap-weather">
  <div class="ap-weather-hero">
    <i class="fa-solid fa-cloud-sun-rain"></i>
    <div><strong>{{zone}}</strong><small>{{#if hereName}}You're in {{hereName}}{{else}}Pick a region{{/if}}</small></div>
  </div>
  <div class="ap-row">
    <select data-zone>{{#each zones}}<option {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    <button type="button" class="ap-pill" data-action="apForecast" {{#unless signal}}disabled{{/unless}}><i class="fa-solid fa-satellite-dish"></i> Forecast</button>
  </div>
  {{#if forecast}}
  {{#each forecast.days}}
  <h4 class="ap-subhead">{{label}}</h4>
  <div class="ap-forecast">{{{html}}}</div>
  {{/each}}
  {{else}}
  <p class="ap-hint-center">Tap Forecast for today and tomorrow.</p>
  {{/if}}
</div>
